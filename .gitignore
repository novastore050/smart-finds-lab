# working files (safe to delete)
temp/*
!temp/.gitkeep
logs/*
!logs/.gitkeep
# large media - keep originals backed up elsewhere (cloud drive)
assets/video/**/*.mp4
assets/video/**/*.mov
output/**/*.mp4
.venv/
__pycache__/
*.pyc
Smart-Finds-Lab.zip
# generated test media - recreate with: python scripts/sfl.py make-test-media
samples/test-media/

# ---- production studio
# secrets (keys go in environment variables, never in files)
.env
*.env
# free ElevenLabs previews (their files, for listening only)
productions/_voice-samples/
# generated voice audio and product photos/thumbnails (large and/or licensed media)
productions/*/voice/*.mp3
productions/*/voice/*.wav
productions/*/voice/*.m4a
productions/*/thumbnails/*.jpg
assets/images/**/*.jpg
assets/images/**/*.jpeg
assets/images/**/*.png
assets/images/**/*.webp
# reference channel transcripts are other people's text - keep them local
references/*/transcripts/*
!references/*/transcripts/.gitkeep
# self-test production and its outputs
productions/zz-*/
references/zz-*/
assets/video/zz-*/
assets/images/zz-*/
output/**/zz-*

# draft / animatic renders and their reports
output/**/*_draft*
output/**/*.precheck.*
