  <lexeme><grapheme>Microplane</grapheme><alias>Micro-plane</alias></lexeme>
  <lexeme><grapheme>TempPro</grapheme><alias>Temp Pro</alias></lexeme>
  <lexeme><grapheme>ThermoPro</grapheme><alias>Thermo Pro</alias></lexeme>
  <lexeme><grapheme>PowerLix</grapheme><alias>Power Licks</alias></lexeme>
  <lexeme><grapheme>OXO</grapheme><alias>ox-oh</alias></lexeme>
